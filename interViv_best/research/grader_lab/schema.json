{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviv.local/research/grader_lab/schema.json",
  "title": "interViv grader-lab example v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example_id",
    "dataset",
    "dataset_version",
    "split",
    "question_id",
    "question",
    "reference_answers",
    "answer",
    "gold_label",
    "concepts",
    "pilot_synthetic"
  ],
  "properties": {
    "schema_version": {"const": "grader-lab-example-v1"},
    "example_id": {"type": "string", "minLength": 1},
    "dataset": {
      "enum": ["scientsbank", "beetle", "ricechem", "internal_perturbation"]
    },
    "dataset_version": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "reference_answers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "answer": {"type": "string"},
    "gold_label": {
      "enum": [
        "correct",
        "partially_correct_incomplete",
        "contradictory",
        "irrelevant",
        "non_domain"
      ]
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^concept\\."},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "pilot_synthetic": {"type": "boolean"},
    "perturbation_type": {"type": "string", "minLength": 1},
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_example_id",
        "trigger_gap_id",
        "gold_resolves_trigger_gap"
      ],
      "properties": {
        "parent_example_id": {"type": "string", "minLength": 1},
        "trigger_gap_id": {"type": "string", "pattern": "^concept\\."},
        "gold_resolves_trigger_gap": {"type": "boolean"}
      }
    },
    "metadata": {"type": "object"}
  }
}
