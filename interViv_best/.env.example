# ── Database ──────────────────────────────────────────────
# Set DATABASE_URL for real PostgreSQL persistence.
# Leave DATABASE_URL blank only for disposable local demos and tests.
# Production refuses to start without it. scripts/run_local.py uses persistent local SQLite.
DATABASE_URL=
INTERVIV_USE_MEMORY_DB=true
ENVIRONMENT=development
# Legacy MongoDB settings are ignored when DATABASE_URL is absent.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=adaptive_mock_interview

# Docker Compose local database settings. Never reuse these values in production.
POSTGRES_DB=interviv
POSTGRES_USER=interviv
POSTGRES_PASSWORD=

# ── Auth ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=1440
ENABLE_ADMIN_ENDPOINTS=false
# Phase 1A: comma-separated emails of signed-up users allowed to act on
# /admin/bundles review routes. Empty = every review action is 403 even when
# the admin router is mounted. Reviewer identity always comes from the token.
ADMIN_USER_EMAILS=
# Phase 1A: reviewed-bundle selector flag. Default off. Nothing in the live
# question flow reads it yet (see docs/phase1a_reviewed_bundles.md).
REVIEWED_BUNDLES_ONLY=false
# Phase 1B experimental concept evaluator (research/admin only). Default off.
EXPERIMENTAL_CONCEPT_EVALUATOR=false
# Staged interview flow Slice 1: automatic inline bundle follow-ups. Default off.
STAGED_INLINE_FOLLOW_UPS=false

# ── API ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Session ───────────────────────────────────────────────
MAX_ROUNDS=9
INITIAL_ELO=1200
# How many rounds per skill before rotating to the next skill
ROUNDS_PER_SKILL=3

# ── LLM question generation ──────────────────────────────
# Start with offline practice. Live generation requires both LLM_LIVE_FETCH=1
# and an explicit llm/llm_csv_fallback mode plus provider credentials.
QUESTION_GENERATION_MODE=csv
QUESTION_REQUIRE_LLM=false
# Options: auto, openai, openrouter, ollama
QUESTION_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Local Ollama (used automatically when QUESTION_LLM_PROVIDER=auto and no cloud key is set)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
# To intentionally use dataset questions again, set:
# QUESTION_GENERATION_MODE=csv
# To try LLM first and then dataset if the API is unavailable, set:
# QUESTION_GENERATION_MODE=llm_csv_fallback

# ── Production question hardening ────────────────────────
# Redis is optional for a single local process. Configure it for production
# replicas to share authentication and LLM limits. A configured Redis outage
# blocks new sign-ins instead of silently bypassing authentication throttling.
REDIS_URL=
QUESTION_CACHE_TTL_SECONDS=86400
QUESTION_LLM_MAX_RETRIES=3
QUESTION_LLM_RETRY_BASE_SECONDS=0.25
QUESTION_LLM_TIMEOUT_SECONDS=20
QUESTION_LLM_RATE_LIMIT_PER_MINUTE=60
QUESTION_LLM_MAX_TOKENS=600
QUESTION_LLM_TEMPERATURE=0.7

# ── Observability ────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Conservative production sampling (10%). Keep > 0 so traces are enabled;
# raise only after confirming Sentry quota and noise are acceptable.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
# Phase P: Google Fonts CDN is off by default (see frontend/src/styles/fonts.css).
# Re-enable only for an intentional online branded build by restoring the
# @import url("https://fonts.googleapis.com/...") line in frontend/src/index.css.

# ── Jobs explorer (Ticket D / Phase O) ───────────────────
# Official Adzuna Jobs API only. Never scrape LinkedIn/Naukri.
# Leave blank to serve fixture/empty state in local demos and CI.
# JOBS_LIVE_FETCH defaults to 0: credentials alone do not dial outbound.
# Country codes are validated (in, gb, us, …); unsupported codes return 422.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOBS_LIVE_FETCH=0
JOBS_CACHE_TTL_SECONDS=21600
JOBS_RATE_LIMIT_PER_MINUTE=30

# ── Scoring completeness (Track 2) ─────────────────
# Held-out gates not passed; leave disabled.
# LENGTH_RATIO_MULTIPLIER_ENABLED=false

# ── SemanticScorer / Hugging Face Hub (Phase J) ────
# all-MiniLM-L6-v2 is loaded from the local Hub cache. With these set, Hub
# HTTP is blocked before any TCP connect (see docs/phase_j_delivery.md).
# A machine without the cached weights still sticky-degrades — fail-fast at
# startup remains an open product decision.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# ── LLM outbound (Phase Q) ─────────────────────────
# Chat completions default OFF via backend/runtime_env.py (LLM_LIVE_FETCH=0).
# Credentials alone are not a gate — set LLM_LIVE_FETCH=1 deliberately to dial.
# Question generation also requires QUESTION_GENERATION_MODE in {llm, llm_csv_fallback}
# (enforced at call_llm_with_cache_retry / _generate_via_llm so adaptive cannot bypass).
# See docs/phase_p_outbound_audit.md.
LLM_LIVE_FETCH=0

# ── AI interview routing (build step 1; no session-route integration) ──
# Default off preserves legacy model/retry behavior. Real routed dispatch also
# requires LLM_LIVE_FETCH=1 and the matching consumer. Empty consumers = all.
# Role/bundle calls use questions; interviewer turns/debrief use interviewer.
AI_INTERVIEW_ROUTING_ENABLED=0
LLM_LIVE_CONSUMERS=
# Required comma-separated owner order for real content dispatch. Validate every
# ID against the catalog before use: zero price, text chat, context and JSON APIs.
INTERVIEW_CONTENT_MODELS=
# Required comma-separated owner order for blind-answer and audit checks.
# Must come from a different vendor prefix than the generator unless self-check is set.
INTERVIEW_CHECK_MODELS=
# WARNING: Do not enable self-check in production; writer and checker must be distinct model families.
# INTERVIEW_ALLOW_SELF_CHECK=false
# Discovery is an explicit exception, default off; it never selects router IDs.
# Discovery orders eligible models by ID, not quality; prefer the owner's order.
INTERVIEW_ALLOW_CONTENT_DISCOVERY=false
INTERVIEW_CONTENT_MIN_CONTEXT=16384
# Token cap + headroom added only when a content model has mandatory reasoning.
INTERVIEW_CONTENT_REASONING_MAX_TOKENS=1024
# Owner-authorized catalog inspection only (one GET, no completion/journal):
# LLM_LIVE_FETCH=1 LLM_LIVE_CONSUMERS=questions .venv/bin/python -m scripts.list_interview_content_models --diagnostics
# Output lists id, effective context length and supported parameters for selection.
INTERVIEW_CONVERSATION_MODEL=anthropic/claude-haiku-4.5
ALLOW_PAID_CONTENT_FALLBACK=false
# Set only after a confirmed $10 lifetime purchase; otherwise the allowance is 50/day.
OPENROUTER_FREE_HIGH_LIMIT_CONFIRMED=false
# All processes/keys for one account must share this absolute path and label.
# Single host only; no secrets in the label. Never point this at a database.
INTERVIEW_LLM_STATE_PATH=
INTERVIEW_LLM_ACCOUNT=default
# Offline status (counters, blocks, model backoffs, leases); default is read-only:
# .venv/bin/python -m scripts.interview_llm_status --journal /absolute/path/limits.json --account default
# Credit blocks persist across days/restarts. After fixing credits, explicitly add
# --clear-credit-block. For a 401/403, fix access then use --clear-access-block.
# Neither operation refunds requests or bypasses the other block. Scripts read
# exported environment/CLI arguments; they do not load .env automatically.
# Routed pregenerate_bundles requires an explicit --max-requests and cached
# generic role profiles. Use --batch-id to resume the same immutable allowance.
# Batch scope is content-only and shares daily/minute/concurrency limits.

# ── Direct providers (question writing/checking only; never receive candidate data) ──
INTERVIEW_DIRECT_PROVIDERS_ENABLED=0
INTERVIEW_CONTENT_PROVIDER=openrouter
INTERVIEW_CHECK_PROVIDER=openrouter
NVIDIA_API_KEY=
GROQ_API_KEY=
NVIDIA_CONTENT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
GROQ_CONTENT_BACKUP_MODEL=qwen/qwen3.8-27b
GROQ_CHECK_MODEL=openai/gpt-oss-120b
