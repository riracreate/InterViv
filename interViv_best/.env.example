# ── Database ──────────────────────────────────────────────
# Set DATABASE_URL for real PostgreSQL persistence.
# Leave DATABASE_URL blank to use the in-memory fallback for local demos and CI.
DATABASE_URL=
INTERVIV_USE_MEMORY_DB=true
ENVIRONMENT=development
# Legacy MongoDB settings are ignored when DATABASE_URL is absent.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=adaptive_mock_interview

# Docker Compose local database settings. Never reuse these values in production.
POSTGRES_DB=interviv
POSTGRES_USER=interviv
POSTGRES_PASSWORD=

# ── Auth ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=1440
ENABLE_ADMIN_ENDPOINTS=false

# ── API ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Session ───────────────────────────────────────────────
MAX_ROUNDS=9
INITIAL_ELO=1200
# How many rounds per skill before rotating to the next skill
ROUNDS_PER_SKILL=3

# ── LLM question generation ──────────────────────────────
# Default live interviews use the LLM. The CSV dataset stays for scoring,
# evaluation, retraining, and dashboard history/reference workflows.
QUESTION_GENERATION_MODE=llm
# In llm mode, fail loudly if the provider call fails instead of using fallback questions.
QUESTION_REQUIRE_LLM=true
# Options: auto, openai, openrouter
QUESTION_LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# To intentionally use dataset questions again, set:
# QUESTION_GENERATION_MODE=csv
# To try LLM first and then dataset if the API is unavailable, set:
# QUESTION_GENERATION_MODE=llm_csv_fallback

# ── Production question hardening ────────────────────────
# Redis is optional locally. In production it enables shared 24h LLM question
# caching and cross-instance LLM rate limiting.
REDIS_URL=
QUESTION_CACHE_TTL_SECONDS=86400
QUESTION_LLM_MAX_RETRIES=3
QUESTION_LLM_RETRY_BASE_SECONDS=0.25
QUESTION_LLM_TIMEOUT_SECONDS=20
QUESTION_LLM_RATE_LIMIT_PER_MINUTE=60
QUESTION_LLM_MAX_TOKENS=600
QUESTION_LLM_TEMPERATURE=0.7

# ── Observability ────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
