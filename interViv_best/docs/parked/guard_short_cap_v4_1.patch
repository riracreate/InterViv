+def test_guard_v4_similarity_alone_does_not_lift_short_cap() -> None:
+    # Verbatim fragment of a long reference: high overlap, still capped.
+    out = check_answer_quality_v4(
+        "Encapsulation hides internal state",
+        question_text="Explain the four pillars of OOP.",
+        ideal_answer=OOP_IDEAL,
+    )
+    assert out["reason"] == "too_short"
+
+
 def test_guard_v4_still_catches_gibberish_and_repetition() -> None:
     assert check_answer_quality_v4("asdf qwer zxcv jkl;")["reason"] == "gibberish"
